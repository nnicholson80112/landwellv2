# ---- Core ----
PORT=8787
PUBLIC_URL=https://app.yourdomain.com     # used in links we text out (signing, apply, pay)
TZ_DEFAULT=America/Denver
DATA_FILE=./data/landwell.json            # MVP storage; swap for Postgres (db/schema.sql) before scale
OWNER_API_TOKEN=change-me                 # MVP owner login token; replace with real auth
SEED_DEMO=true                            # seed the demo owner/homes on first start

# ---- Communication AI (pick one) ----
AI_PROVIDER=rules                         # rules | anthropic | http  (http = our in-house AI service)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                          # e.g. the current Claude Sonnet model id
AI_HTTP_URL=                              # your in-house AI endpoint (see docs/AI-PLUGIN.md)
AI_HTTP_TOKEN=

# ---- In-house AI service (second Railway service: npm run ai) ----
AI_SERVICE_TOKEN=
AI_MODEL_PRIMARY=anthropic                # anthropic | openai-compat | rules
AI_MODEL_BACKUP=
OPENAI_COMPAT_URL=                        # self-hosted model endpoint (vLLM/Ollama), later
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_KEY=
AI_LOG_DIR=/data/ai-logs
AI_LOG_RETENTION_DAYS=90

# ---- Texting (Twilio) ----  needs A2P 10DLC registration before sending to tenants
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                        # also used to verify incoming webhooks
TWILIO_FROM=                              # +1XXXXXXXXXX or a Messaging Service SID (MG...)

# ---- Email (Postmark) ----
POSTMARK_TOKEN=
EMAIL_FROM=Landwell <hello@yourdomain.com>
EMAIL_WEBHOOK_SECRET=                     # add ?key=... to the inbound webhook URL

# ---- Voice agent (any vendor or in-house) ----
VOICE_WEBHOOK_SECRET=

# ---- Rent (Stripe, ACH) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Smart locks (Seam) ----
SEAM_API_KEY=

# ---- Partner webhooks ----
SCREENING_WEBHOOK_SECRET=
IDENTITY_WEBHOOK_SECRET=

# ---- Demo on a real home ----
DEMO_OWNER_NAME=
DEMO_OWNER_PHONE=
DEMO_ADDRESS=7610 S Rosemary Cir
DEMO_CITY=Centennial
DEMO_ZIP=80112
DEMO_BEDS=
DEMO_BATHS=
DEMO_RENT=
DEMO_TENANT_PHONE=
DEMO_VENDOR_NAME=GlassHouse Exteriors
DEMO_VENDOR_PHONE=+17209305782
DEMO_VENDOR_EMAIL=
TWILIO_VOICE=Polly.Joanna
