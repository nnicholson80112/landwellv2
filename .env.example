# ---- Core ----
PORT=8787
PUBLIC_URL=https://app.yourdomain.com     # used in links we text out (signing, apply, pay)
TZ_DEFAULT=America/Denver
DATA_FILE=./data/keyhelm.json            # JSON file storage, used when DATABASE_URL is empty (imported into Postgres once on its first run)
DATABASE_URL=                             # Postgres, e.g. postgres://user:password@host:5432/db (Railway: reference ${{Postgres.DATABASE_URL}})
PGSSLMODE=                                # optional: disable | prefer (default) | require | verify-ca | verify-full (or ?sslmode= in the URL)
DATABASE_SSL_REJECT_UNAUTHORIZED=         # optional: true to check the database's TLS certificate even with sslmode=require
OWNER_API_TOKEN=change-me                 # MVP owner login token; replace with real auth
SEED_DEMO=true                            # seed the demo owner/homes on first start

# ---- Communication AI (pick one) ----
AI_PROVIDER=rules                         # rules | anthropic | http  (http = our in-house AI service)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                          # e.g. the current Claude Sonnet model id
AI_HTTP_URL=                              # your in-house AI endpoint (see docs/AI-PLUGIN.md)
AI_HTTP_TOKEN=

# ---- In-house AI service (second Railway service: npm run ai) ----
AI_SERVICE_TOKEN=
AI_MODEL_PRIMARY=anthropic                # anthropic | openai-compat | rules
AI_MODEL_BACKUP=
OPENAI_COMPAT_URL=                        # self-hosted model endpoint (vLLM/Ollama), later
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_KEY=
AI_LOG_DIR=/data/ai-logs
AI_LOG_RETENTION_DAYS=90

# ---- Texting (Twilio) ----  needs A2P 10DLC registration before sending to tenants
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                        # also used to verify incoming webhooks
TWILIO_FROM=                              # +1XXXXXXXXXX or a Messaging Service SID (MG...)

# ---- Email (Postmark) ----
POSTMARK_TOKEN=
EMAIL_FROM=KeyHelm <hello@yourdomain.com>
EMAIL_WEBHOOK_SECRET=                     # add ?key=... to the inbound webhook URL

# ---- Voice agent (any vendor or in-house) ----
VOICE_WEBHOOK_SECRET=

# ---- KeyHelm's own subscription billing (Stripe). KeyHelm NEVER collects rent ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Admin console (/admin: private offers, customers) ----
ADMIN_API_TOKEN=

# ---- Onboarding call after purchase (Calendly) ----
CALENDLY_URL=                             # your onboarding event link
CALENDLY_TOKEN=                           # optional: personal access token, for booking tracking
CALENDLY_WEBHOOK_SECRET=                  # optional: any long random string

# ---- Smart locks (Seam) ----
SEAM_API_KEY=

# ---- Partner webhooks ----
SCREENING_WEBHOOK_SECRET=
IDENTITY_WEBHOOK_SECRET=

# ---- Demo on a real home ----
DEMO_OWNER_NAME=
DEMO_OWNER_PHONE=
DEMO_ADDRESS=7610 S Rosemary Cir
DEMO_CITY=Centennial
DEMO_ZIP=80112
DEMO_BEDS=
DEMO_BATHS=
DEMO_RENT=
DEMO_TENANT_PHONE=
DEMO_VENDOR_NAME=GlassHouse Exteriors
DEMO_VENDOR_PHONE=+17209305782
DEMO_VENDOR_EMAIL=
TWILIO_VOICE=Polly.Joanna
